# Local project settings
ATLAS_ENV=development
ATLAS_STORAGE_ROOT=data
ATLAS_LOG_LEVEL=INFO

# Future object storage settings. Leave unset for local-only Step 1.
ATLAS_OBJECT_STORAGE_BUCKET=
ATLAS_OBJECT_STORAGE_PREFIX=

# Future Dataset Engine connection.
# Get the real password from the one-time FDE credential response.
# Do not commit a real DATABASE_URL. Keep it only in your local .env.
DATABASE_URL=postgresql://role_atlas:PASSWORD@127.0.0.1:5432/future_datasets?options=-c%20search_path%3Dapp_atlas
DATABASE_SCHEMA=app_atlas
ATLAS_USE_FDE_TABLES=false
ATLAS_FDE_PRIMARY_TABLE=data_centers
ATLAS_FDE_DATA_CENTERS_TABLE=data_centers
ATLAS_FDE_POWER_PLANTS_TABLE=
ATLAS_FDE_ENERGY_SITES_TABLE=
ATLAS_FDE_CABLES_TABLE=

# Stripe Payment Integration Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE

# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe recurring Price IDs for commercial API subscriptions
STRIPE_PRICE_LAUNCH=price_YOUR_LAUNCH_PRICE_ID
STRIPE_PRICE_SCALE=price_YOUR_SCALE_PRICE_ID
STRIPE_PRICE_ENTERPRISE=price_YOUR_ENTERPRISE_PRICE_ID
PUBLIC_APP_URL=http://127.0.0.1:5174

# Site Selection Storage
# Override default storage path (data/reports/site_selection) for JSONL candidate files.
SITE_SELECTION_STORAGE_DIR=
# Number of days to retain candidate query JSONL files before cleanup (default 7).
SITE_SELECTION_RETENTION_DAYS=7

# SMTP Email Delivery for API Key provisioning
# Unset these to disable email sending (keys are logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@futureinfrastructure.com
SMTP_FROM_NAME=FUTURE Infrastructure Atlas
SMTP_USE_TLS=true
